# Anthropic API key for AI analysis
# chmod 600 this file after copying (the app also tightens mode on startup)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: AI calls per client IP per minute (default 30; 0 disables)
# FATHOM_AI_RATE_LIMIT=30

# AWS profile for S3 backups (uses system AWS credentials)
AWS_PROFILE=default

# S3 bucket for database backups
S3_BACKUP_BUCKET=your-bucket-name

# SSH target for bin/deploy-mini and bin/mini-logs.
# Prefer a Host entry in ~/.ssh/config (e.g. Host mini) over user@lan-ip
# so those coordinates never live in the public repo.
# FATHOM_MINI_HOST=mini
# Repo path on that host (defaults to this clone's path)
# FATHOM_MINI_REPO=/path/to/aquarium-tracker

# Database path (default: fathom/data/fathom.db relative to repo root)
# DB_PATH=/path/to/custom/fathom.db

# App host/port (defaults: 0.0.0.0:8000)
# HOST=0.0.0.0
# PORT=8000
